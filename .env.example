# Ambiente: local | test | staging | production
NODE_ENV=local

# Puerto HTTP de la API
PORT=3000

# URL de oracle-web. Tambien se usa como origen permitido en CORS.
APP_URL=http://localhost:3001
API_URL=http://localhost:3000/api/v1

# Secretos de firma de JWT. Deben ser distintos entre si y tener al menos 32
# caracteres. Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-32-chars-long

# Secreto HMAC para la seleccion deterministica de la carta diaria. Debe ser
# distinto de los secretos de JWT y tener al menos 32 caracteres.
DAILY_CARD_SECRET=replace-with-a-third-random-secret-32-chars-long

# Proveedor de IA (OpenAI). La API key nunca debe subirse al repositorio.
OPENAI_API_KEY=sk-replace-with-a-real-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL (ver docker-compose.yml para las credenciales locales)
DATABASE_URL=postgresql://oracle:oracle@localhost:5432/oracle_api?schema=public

# Base de datos aislada para pruebas de integracion (creada por docker/postgres-init)
DATABASE_URL_TEST=postgresql://oracle:oracle@localhost:5432/oracle_api_test?schema=public

# Redis / BullMQ (ver docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# Base logica de Redis aislada para pruebas de integracion
REDIS_URL_TEST=redis://localhost:6379/1

# Almacenamiento de imagenes (compatible con S3). En local apunta al MinIO de
# docker-compose.yml; en produccion apunta a DigitalOcean Spaces. Las
# credenciales del MinIO local son fijas (ver docker-compose.yml), no son un
# secreto real.
SPACES_ENDPOINT=http://localhost:9000
SPACES_REGION=us-east-1
SPACES_BUCKET=oracle-palm-images
SPACES_ACCESS_KEY=oracle-minio
SPACES_SECRET_KEY=oracle-minio-secret

# Limites de subida de imagenes de lectura de manos
PALM_IMAGE_MAX_SIZE_BYTES=10485760
PALM_IMAGE_RETENTION_HOURS=24

# Creditos de bono que recibe cada usuario nuevo al registrarse. Es una
# hipotesis comercial, no una constante fija; ajustable sin tocar codigo.
WALLET_INITIAL_BONUS_CREDITS=10

# Wompi (pagos). Usar llaves de PRUEBA (prefijo _test) en local/staging,
# nunca las de produccion. WOMPI_INTEGRITY_SECRET firma el Web Checkout;
# WOMPI_EVENTS_SECRET firma los webhooks entrantes (son secretos distintos,
# aunque Wompi los entrega juntos en el mismo panel de comercio).
WOMPI_PUBLIC_KEY=pub_test_replace-with-a-real-wompi-public-key
WOMPI_PRIVATE_KEY=prv_test_replace-with-a-real-wompi-private-key
WOMPI_EVENTS_SECRET=replace-with-the-real-wompi-events-secret
WOMPI_INTEGRITY_SECRET=replace-with-the-real-wompi-integrity-secret
WOMPI_API_URL=https://sandbox.wompi.co/v1

# Tasa aproximada USD -> COP solo para estimar el margen en el dashboard
# admin (costo de IA se cobra en USD). Ajustable, no se usa para pagos.
AI_COST_USD_TO_COP_RATE=4000

# Opcional: DSN de Sentry para captura de errores y alertas. Sin definir,
# el SDK queda inicializado pero inactivo (no envía nada).
SENTRY_DSN=
